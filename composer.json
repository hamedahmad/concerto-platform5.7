{
  "name": "hamedahmad/concerto-platform5.7",
  "license": "AGPLv3",
  "type": "project",
  "description": "Online adaptive testing platform",
  "autoload": {
    "psr-4": {
      "": "src/"
    },
    "classmap": [
      "app/AppKernel.php",
      "app/AppCache.php"
    ]
  },
  "autoload-dev": {
    "psr-4": { "Tests\\": "tests/" },
    "files": [ "vendor/symfony/symfony/src/Symfony/Component/VarDumper/Resources/functions/dump.php" ]
  },
  "require": {
    "php": "^7.1 || ^8.2",
    "cocur/slugify": "~1.0",
    "doctrine/annotations": "^1.13",
    "doctrine/cache": "^1.11",
    "doctrine/doctrine-bundle": "^1.6",
    "doctrine/orm": "^2.5",
    "friendsofsymfony/oauth-server-bundle": "~1.5.2",
    "incenteev/composer-parameter-handler": "^2.0",
    "jms/serializer": "1.13.0",
    "jms/serializer-bundle": "1.5.0",
    "sensio/distribution-bundle": "^5.0.19",
    "sensio/framework-extra-bundle": "^5.0.0",
    "symfony/monolog-bundle": "^3.1.0",
    "symfony/polyfill-apcu": "^1.0",
    "symfony/swiftmailer-bundle": "^2.6.4",
    "symfony/symfony": "3.4.*",
    "twig/twig": "^2.15"
  },
  "require-dev": {
    "sensio/generator-bundle": "^3.0",
    "symfony/phpunit-bridge": "^3.0"
  },
  "scripts": {},
  "config": {
    "platform": {
      "php": "7.4"
    },
    "conflict": {
      "jms/serializer": ">=2.0"
    },
    "sort-packages": true,
    "audit": {
      "block-insecure": false
    }
  },
  "extra": {
    "symfony-app-dir": "app",
    "symfony-bin-dir": "bin",
    "symfony-var-dir": "var",
    "symfony-web-dir": "web",
    "symfony-tests-dir": "tests",
    "symfony-assets-install": "relative",
    "incenteev-parameters": [
      {
        "file": "app/config/parameters_test_runner.yml"
      },
      {
        "file": "app/config/parameters_uio.yml"
      },
      {
        "file": "app/config/parameters_administration.yml"
      },
      {
        "file": "app/config/parameters.yml"
      }
    ],
    "branch-alias": {
      "dev-master": "3.4-dev"
    }
  }
}
